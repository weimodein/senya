<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/onboarding_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/onboarding_back"
            android:src="@drawable/onboarding_back"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/onboarding_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/app_name"
            android:textColor="@color/onboarding_ink"
            android:textSize="21sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/onboarding_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/onboarding_welcome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="36dp"
                android:paddingBottom="24dp">

                <ImageView
                    android:layout_width="136dp"
                    android:layout_height="136dp"
                    android:contentDescription="@null"
                    android:src="@drawable/onboarding_hand" />

                <TextView
                    style="@style/OnboardingTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="46dp"
                    android:gravity="center"
                    android:text="@string/onboarding_welcome_title" />

                <TextView
                    style="@style/OnboardingBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/onboarding_welcome_body" />

                <TextView
                    style="@style/OnboardingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="38dp"
                    android:background="@drawable/onboarding_chip"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp"
                    android:text="@string/onboarding_example_letters"
                    android:textStyle="bold" />

                <TextView
                    style="@style/OnboardingBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="↓" />

                <TextView
                    style="@style/OnboardingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/onboarding_pill"
                    android:paddingStart="32dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="32dp"
                    android:paddingBottom="8dp"
                    android:text="@string/onboarding_example_word"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/onboarding_camera"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="20dp"
                android:visibility="gone">

                <TextView
                    style="@style/OnboardingTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/onboarding_camera_title" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="270dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/onboarding_photo"
                    android:clipToOutline="true">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/onboarding_photo_description"
                        android:scaleType="centerCrop"
                        android:src="@drawable/onboarding_camera_guide" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="14dp"
                        android:background="@drawable/onboarding_frame"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="24dp"
                        android:background="@drawable/onboarding_chip"
                        android:paddingStart="8dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="4dp"
                        android:text="@string/onboarding_framing_guide"
                        android:textColor="@color/onboarding_ink"
                        android:textSize="12sp" />
                </FrameLayout>

                <TextView
                    style="@style/OnboardingLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/onboarding_camera_tip" />

                <TextView
                    style="@style/OnboardingBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/onboarding_camera_body" />

                <TextView
                    android:id="@+id/onboarding_camera_error"
                    style="@style/OnboardingBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/mp_color_error"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/onboarding_voice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="20dp"
                android:visibility="gone">

                <TextView
                    style="@style/OnboardingTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/onboarding_voice_title" />

                <TextView
                    style="@style/OnboardingBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:text="@string/onboarding_voice_label" />

                <TextView
                    android:id="@+id/onboarding_voice_picker"
                    style="@style/OnboardingLabel"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:paddingEnd="8dp"
                    android:text="@string/onboarding_voice_loading" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/onboarding_rule" />

                <TextView
                    android:id="@+id/onboarding_voice_status"
                    style="@style/OnboardingLabel"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:gravity="center_vertical"
                    android:text="@string/onboarding_voice_loading" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/onboarding_rule" />

                <TextView
                    android:id="@+id/onboarding_test_voice"
                    style="@style/OnboardingLabel"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:text="@string/onboarding_test_voice"
                    android:textColor="@color/onboarding_blue" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/onboarding_rule" />

                <TextView
                    android:id="@+id/onboarding_voice_settings"
                    style="@style/OnboardingLabel"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:text="@string/onboarding_voice_settings"
                    android:textColor="@color/onboarding_blue" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/onboarding_ready"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="20dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/onboarding_ready_title"
                    style="@style/OnboardingTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/onboarding_ready_title" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_marginTop="40dp"
                    android:contentDescription="@null"
                    android:src="@drawable/onboarding_airplane" />

                <TextView
                    style="@style/OnboardingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/onboarding_pill"
                    android:paddingStart="18dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="8dp"
                    android:text="@string/onboarding_ready_badge" />

                <TextView
                    android:id="@+id/onboarding_model_status"
                    style="@style/OnboardingLabel"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="32dp"
                    android:gravity="center_vertical"
                    android:text="@string/onboarding_model_checking" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/onboarding_rule" />

                <TextView
                    android:id="@+id/onboarding_ready_voice_status"
                    style="@style/OnboardingLabel"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:text="@string/onboarding_voice_loading" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/onboarding_rule" />

                <TextView
                    android:id="@+id/onboarding_ready_body"
                    style="@style/OnboardingLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/onboarding_ready_body" />

                <TextView
                    style="@style/OnboardingBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/onboarding_ready_note" />

                <TextView
                    android:id="@+id/onboarding_demo_note"
                    style="@style/OnboardingBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/onboarding_demo_note"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/onboarding_ready_error"
                    style="@style/OnboardingBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/mp_color_error"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/onboarding_dots"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center"
        android:orientation="horizontal" />

    <Button
        android:id="@+id/onboarding_primary"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/onboarding_primary"
        android:backgroundTint="@null"
        android:text="@string/onboarding_get_started"
        android:textAllCaps="false"
        android:textColor="@color/onboarding_ink"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/onboarding_secondary"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:backgroundTint="@android:color/transparent"
        android:text="@string/onboarding_not_now"
        android:textAllCaps="false"
        android:textColor="@color/onboarding_blue"
        android:textSize="15sp"
        android:visibility="gone" />
</LinearLayout>
