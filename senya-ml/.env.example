# Backend the ML service reports to (local, or the Render URL)
BACKEND_URL=http://localhost:8000

# Shared secret: must equal ML_API_KEY in senya-backend/.env
ML_API_KEY=change-me-to-a-long-random-string

# Optional tuning
TRAIN_EPOCHS=60
STATIC_STEP_MS=100
STATIC_MAX_SAMPLES=60
MOTION_MAX_FPS=30
TRIM_PAD_MS=150
# HAND_LANDMARKER_MODEL=app/models/hand_landmarker.task
