# Supabase → Project Settings → Database → Connection string → **Session pooler** (not "Direct connection")
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Server (8000 is what the Android app's local setup and `adb reverse tcp:8000 tcp:8000` expect)
PORT=8000

# JWT signing secret: a long random string
JWT_SECRET=change-me
JWT_EXPIRES_IN=12h

# The one admin account, created/updated from these on every start
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ML service (senya-ml) address and the shared key (must equal ML_API_KEY in senya-ml/.env)
ML_SERVICE_URL=http://localhost:8001
ML_API_KEY=change-me-to-a-long-random-string

# Admin panel dev server (only needed when the panel runs on a different origin)
ALLOWED_ORIGINS=http://localhost:5173

# Tests only: run the test suite inside this Postgres schema so it never touches real data
# DB_SCHEMA=senya_test
